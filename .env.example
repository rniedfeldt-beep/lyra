# Copy this file to .env.local and fill in your Supabase project's values.
# Find both under Project Settings > API in the Supabase dashboard.
# The anon key is meant to be public (see CLAUDE.md's Persistence > Security section) —
# it's safe to ship in the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
